# Midl / EVM RPC used by @clawcommit/sdk
MIDL_RPC_URL=https://your-midl-rpc.example

# Deployed ClawCommit contract (must be 42-char EVM address)
CLAWCOMMIT_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890

# Server signer used for commit/reveal writes
DEPLOYER_PRIVATE_KEY=0xabc123...

# Only set true if you intentionally write on BSC mainnet
ALLOW_MAINNET_WRITES=false

# Optional: override tx links if Midl has its own explorer
MIDL_EXPLORER_BASE_URL=https://explorer.example

# Optional: used for private repos or higher GitHub API rate limits
GITHUB_TOKEN=ghp_xxx
