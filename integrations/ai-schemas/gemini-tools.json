  {
    "name": "clawcommit_openclaw_gemini_build_payload",
    "description": "Build deterministic Gemini payload envelope and expanded hash metadata.",
    "parameters": {
      "type": "OBJECT",
      "properties": {
        "prompt": {
          "type": "STRING",
          "description": "Gemini prompt context."
        },
        "output": {
          "type": "STRING",
          "description": "Gemini output/decision text."
        },
        "model_version": {
          "type": "STRING",
          "description": "Gemini model version."
        },
        "preset": {
          "type": "STRING",
          "enum": [
            "geminiPro",
            "geminiFlash"
          ]
        },
        "generation_config": {
          "type": "OBJECT",
          "description": "Gemini generation config with temperature/topP/candidateCount/stopSequences/safetySettings."
        },
        "nonce": {
          "type": "STRING",
          "description": "Nonce used for commit/reveal."
        },
        "nonce_strategy": {
          "type": "STRING",
          "enum": [
            "random",
            "counter"
          ]
        },
        "nonce_counter_file": {
          "type": "STRING",
          "description": "Optional counter file for nonce_strategy=counter."
        },
        "log_sensitive": {
          "type": "BOOLEAN",
          "description": "Set true to include prompt/output/nonce in responses."
        }
      },
      "required": [
        "prompt",
        "output"
      ]
    }
  },
