[
  {
    "name": "clawcommit_commit",
    "description": "Commit an AI decision hash to BNB Chain from prompt, output, modelVersion, and nonce.",
    "parameters": {
      "type": "OBJECT",
      "properties": {
        "prompt": {
          "type": "STRING",
          "description": "Prompt/context used by AI."
        },
        "output": {
          "type": "STRING",
          "description": "Model output/decision string."
        },
        "model_version": {
          "type": "STRING",
          "description": "Model version string."
        },
        "nonce": {
          "type": "STRING",
          "description": "Optional nonce; generate one if omitted."
        },
        "contract_address": {
          "type": "STRING",
          "description": "Deployed ClawCommit contract address."
        },
        "private_key": {
          "type": "STRING",
          "description": "Wallet private key for signing transaction."
        },
        "rpc_url": {
          "type": "STRING",
          "description": "Optional BSC RPC endpoint URL."
        },
        "allow_mainnet_writes": {
          "type": "BOOLEAN",
          "description": "Set true to allow state-changing operations on BSC mainnet."
        },
        "log_sensitive": {
          "type": "BOOLEAN",
          "description": "Set true to include prompt/output/nonce in logs and responses."
        }
      },
      "required": [
        "prompt",
        "output",
        "model_version",
        "contract_address",
        "private_key"
      ]
    }
  },
