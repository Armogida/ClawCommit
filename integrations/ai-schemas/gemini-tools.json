  {
    "name": "clawcommit_openclaw_build_payload",
    "description": "Build deterministic OpenClaw prompt/output payload from CI validation metadata.",
    "parameters": {
      "type": "OBJECT",
      "properties": {
        "model_version": {
          "type": "STRING",
          "description": "Model version for the OpenClaw decision."
        },
        "context": {
          "type": "OBJECT",
          "description": "OpenClaw workflow context.",
          "properties": {
            "workflow": {
              "type": "STRING"
            },
            "repository": {
              "type": "STRING"
            },
            "ref": {
              "type": "STRING"
            },
            "sha": {
              "type": "STRING"
            },
            "actor": {
              "type": "STRING"
            },
            "runId": {
              "type": "STRING"
            },
            "runUrl": {
              "type": "STRING"
            }
          },
          "required": [
            "workflow",
            "repository"
          ]
        },
        "validations": {
          "type": "ARRAY",
          "items": {
            "type": "OBJECT",
            "properties": {
              "name": {
                "type": "STRING"
              },
              "passed": {
                "type": "BOOLEAN"
              },
              "required": {
                "type": "BOOLEAN"
              },
              "details": {
                "type": "STRING"
              }
            },
            "required": [
              "name",
              "passed"
            ]
          }
        },
        "log_sensitive": {
          "type": "BOOLEAN",
          "description": "Set true to include full prompt in responses."
        }
      },
      "required": [
        "model_version",
        "context",
        "validations"
      ]
    }
  },
