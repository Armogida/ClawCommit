[
  {
    "name": "clawcommit_commit",
    "description": "Commit an AI decision hash to BNB Chain. Hash is computed from prompt, output, modelVersion, and nonce.",
    "input_schema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "Prompt/context used by the AI model."
        },
        "output": {
          "type": "string",
          "description": "Model output or decision string."
        },
        "model_version": {
          "type": "string",
          "description": "Model version used to generate output."
        },
        "nonce": {
          "type": "string",
          "description": "Optional nonce; generate one if omitted."
        },
        "contract_address": {
          "type": "string",
          "description": "Deployed ClawCommit contract address."
        },
        "private_key": {
          "type": "string",
          "description": "Wallet private key for signing the transaction."
        },
        "rpc_url": {
          "type": "string",
          "description": "Optional BSC RPC endpoint URL."
        },
        "allow_mainnet_writes": {
          "type": "boolean",
          "description": "Set true to allow state-changing operations on BSC mainnet."
        },
        "log_sensitive": {
          "type": "boolean",
          "description": "Set true to include prompt/output/nonce in logs and responses."
        }
      },
      "required": ["prompt", "output", "model_version", "contract_address", "private_key"]
    }
  },
  {
    "name": "clawcommit_reveal",
    "description": "Reveal a previously committed decision payload.",
    "input_schema": {
      "type": "object",
      "properties": {
        "commit_id": {
          "type": "integer",
          "description": "Commitment ID to reveal."
        },
        "prompt": {
          "type": "string",
          "description": "Original prompt."
        },
        "output": {
          "type": "string",
          "description": "Original output."
        },
        "model_version": {
          "type": "string",
          "description": "Original model version."
        },
        "nonce": {
          "type": "string",
          "description": "Original nonce."
        },
        "contract_address": {
          "type": "string",
          "description": "Deployed ClawCommit contract address."
        },
        "private_key": {
          "type": "string",
          "description": "Private key of original committer wallet."
        },
        "rpc_url": {
          "type": "string",
          "description": "Optional BSC RPC endpoint URL."
        },
        "allow_mainnet_writes": {
          "type": "boolean",
          "description": "Set true to allow state-changing operations on BSC mainnet."
        },
        "log_sensitive": {
          "type": "boolean",
          "description": "Set true to include prompt/output/nonce in logs and responses."
        }
      },
      "required": ["commit_id", "prompt", "output", "model_version", "nonce", "contract_address", "private_key"]
    }
  },
  {
    "name": "clawcommit_verify",
    "description": "Verify a revealed commitment by replaying deterministic hash computation.",
    "input_schema": {
      "type": "object",
      "properties": {
        "commit_id": {
          "type": "integer",
          "description": "Commitment ID to verify."
        },
        "contract_address": {
          "type": "string",
          "description": "Deployed ClawCommit contract address."
        },
        "rpc_url": {
          "type": "string",
          "description": "Optional BSC RPC endpoint URL."
        },
        "log_sensitive": {
          "type": "boolean",
          "description": "Set true to include prompt/output/nonce in responses."
        }
      },
      "required": ["commit_id", "contract_address"]
    }
  },
  {
    "name": "clawcommit_compute_hash",
    "description": "Compute deterministic hash from prompt/output/modelVersion/nonce.",
    "input_schema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "Prompt/context string."
        },
        "output": {
          "type": "string",
          "description": "Model output string."
        },
        "model_version": {
          "type": "string",
          "description": "Model version string."
        },
        "nonce": {
          "type": "string",
          "description": "Nonce string."
        },
        "contract_address": {
          "type": "string",
          "description": "Optional contract address if using on-chain pure call."
        },
        "rpc_url": {
          "type": "string",
          "description": "Optional BSC RPC endpoint URL."
        },
        "log_sensitive": {
          "type": "boolean",
          "description": "Set true to include prompt/output/nonce in responses."
        }
      },
      "required": ["prompt", "output", "model_version", "nonce"]
    }
  },
  {
    "name": "clawcommit_get_commitment",
    "description": "Retrieve commitment data including prompt/output/modelVersion/nonce when revealed.",
    "input_schema": {
      "type": "object",
      "properties": {
        "commit_id": {
          "type": "integer",
          "description": "Commitment ID to retrieve."
        },
        "contract_address": {
          "type": "string",
          "description": "Deployed ClawCommit contract address."
        },
        "rpc_url": {
          "type": "string",
          "description": "Optional BSC RPC endpoint URL."
        }
      },
      "required": ["commit_id", "contract_address"]
    }
  }
]
