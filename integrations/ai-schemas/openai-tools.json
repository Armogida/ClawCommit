[
  {
    "type": "function",
    "function": {
      "name": "clawcommit_commit",
      "description": "Commit an AI decision hash to BNB Chain. Hash is computed from prompt, output, modelVersion, and nonce; only the hash is stored at commit time.",
      "parameters": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Prompt/context used by the AI model."
          },
          "output": {
            "type": "string",
            "description": "Model output or decision string."
          },
          "model_version": {
            "type": "string",
            "description": "Model version string used to generate the output."
          },
          "nonce": {
            "type": "string",
            "description": "Optional cryptographic nonce. If omitted, generate a secure nonce and return it."
          },
          "contract_address": {
            "type": "string",
            "description": "Deployed ClawCommit contract address on BSC."
          },
          "private_key": {
            "type": "string",
            "description": "Wallet private key for signing commit transaction."
          },
          "rpc_url": {
            "type": "string",
            "description": "Optional BSC RPC endpoint URL."
          },
          "allow_mainnet_writes": {
            "type": "boolean",
            "description": "Set true to allow state-changing operations on BSC mainnet."
          },
          "log_sensitive": {
            "type": "boolean",
            "description": "Set true to include prompt/output/nonce in logs and responses."
          }
        },
        "required": ["prompt", "output", "model_version", "contract_address", "private_key"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "clawcommit_reveal",
      "description": "Reveal a previously committed decision payload. Only original committer can reveal.",
      "parameters": {
        "type": "object",
        "properties": {
          "commit_id": {
            "type": "integer",
            "description": "Commitment ID to reveal."
          },
          "prompt": {
            "type": "string",
            "description": "Original prompt used during commit hash computation."
          },
          "output": {
            "type": "string",
            "description": "Original output used during commit hash computation."
          },
          "model_version": {
            "type": "string",
            "description": "Original model version used during commit hash computation."
          },
          "nonce": {
            "type": "string",
            "description": "Original nonce used during commit hash computation."
          },
          "contract_address": {
            "type": "string",
            "description": "Deployed ClawCommit contract address."
          },
          "private_key": {
            "type": "string",
            "description": "Private key of wallet that created the commitment."
          },
          "rpc_url": {
            "type": "string",
            "description": "Optional BSC RPC endpoint URL."
          },
          "allow_mainnet_writes": {
            "type": "boolean",
            "description": "Set true to allow state-changing operations on BSC mainnet."
          },
          "log_sensitive": {
            "type": "boolean",
            "description": "Set true to include prompt/output/nonce in logs and responses."
          }
        },
        "required": ["commit_id", "prompt", "output", "model_version", "nonce", "contract_address", "private_key"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "clawcommit_verify",
      "description": "Verify a revealed commitment by replaying hash computation over prompt/output/modelVersion/nonce.",
      "parameters": {
        "type": "object",
        "properties": {
          "commit_id": {
            "type": "integer",
            "description": "Commitment ID to verify."
          },
          "contract_address": {
            "type": "string",
            "description": "Deployed ClawCommit contract address."
          },
          "rpc_url": {
            "type": "string",
            "description": "Optional BSC RPC endpoint URL."
          },
          "log_sensitive": {
            "type": "boolean",
            "description": "Set true to include prompt/output/nonce in responses."
          }
        },
        "required": ["commit_id", "contract_address"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "clawcommit_compute_hash",
      "description": "Compute deterministic keccak256 hash from prompt, output, modelVersion, nonce without blockchain writes.",
      "parameters": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Prompt/context string."
          },
          "output": {
            "type": "string",
            "description": "Model output/decision string."
          },
          "model_version": {
            "type": "string",
            "description": "Model version string."
          },
          "nonce": {
            "type": "string",
            "description": "Nonce string."
          },
          "contract_address": {
            "type": "string",
            "description": "Optional contract address if using on-chain pure call instead of local hashing."
          },
          "rpc_url": {
            "type": "string",
            "description": "Optional BSC RPC endpoint URL."
          },
          "log_sensitive": {
            "type": "boolean",
            "description": "Set true to include prompt/output/nonce in responses."
          }
        },
        "required": ["prompt", "output", "model_version", "nonce"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "clawcommit_get_commitment",
      "description": "Retrieve commitment data including prompt/output/modelVersion/nonce (if revealed).",
      "parameters": {
        "type": "object",
        "properties": {
          "commit_id": {
            "type": "integer",
            "description": "Commitment ID to retrieve."
          },
          "contract_address": {
            "type": "string",
            "description": "Deployed ClawCommit contract address."
          },
          "rpc_url": {
            "type": "string",
            "description": "Optional BSC RPC endpoint URL."
          }
        },
        "required": ["commit_id", "contract_address"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "clawcommit_openclaw_build_payload",
      "description": "Build deterministic OpenClaw prompt/output payload from CI validation metadata.",
      "parameters": {
        "type": "object",
        "properties": {
          "model_version": {
            "type": "string",
            "description": "Model version for the OpenClaw decision."
          },
          "context": {
            "type": "object",
            "description": "OpenClaw workflow context.",
            "properties": {
              "workflow": { "type": "string" },
              "repository": { "type": "string" },
              "ref": { "type": "string" },
              "sha": { "type": "string" },
              "actor": { "type": "string" },
              "runId": { "type": "string" },
              "runUrl": { "type": "string" }
            },
            "required": ["workflow", "repository"]
          },
          "validations": {
            "type": "array",
            "description": "Validation results list.",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "passed": { "type": "boolean" },
                "required": { "type": "boolean" },
                "details": { "type": "string" }
              },
              "required": ["name", "passed"]
            }
          },
          "log_sensitive": {
            "type": "boolean",
            "description": "Set true to include full prompt in responses."
          }
        },
        "required": ["model_version", "context", "validations"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "clawcommit_openclaw_commit",
      "description": "Build deterministic OpenClaw payload and commit it on-chain.",
      "parameters": {
        "type": "object",
        "properties": {
          "model_version": { "type": "string" },
          "context": {
            "type": "object",
            "properties": {
              "workflow": { "type": "string" },
              "repository": { "type": "string" },
              "ref": { "type": "string" },
              "sha": { "type": "string" },
              "actor": { "type": "string" },
              "runId": { "type": "string" },
              "runUrl": { "type": "string" }
            },
            "required": ["workflow", "repository"]
          },
          "validations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "passed": { "type": "boolean" },
                "required": { "type": "boolean" },
                "details": { "type": "string" }
              },
              "required": ["name", "passed"]
            }
          },
          "nonce": { "type": "string" },
          "contract_address": { "type": "string" },
          "network": { "type": "string", "enum": ["bscMainnet", "bscTestnet"] },
          "allow_mainnet_writes": { "type": "boolean" },
          "log_sensitive": { "type": "boolean" }
        },
        "required": ["model_version", "context", "validations", "contract_address"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "clawcommit_openclaw_reveal",
      "description": "Build deterministic OpenClaw payload and reveal an existing commitment.",
      "parameters": {
        "type": "object",
        "properties": {
          "commit_id": { "type": "integer" },
          "model_version": { "type": "string" },
          "context": {
            "type": "object",
            "properties": {
              "workflow": { "type": "string" },
              "repository": { "type": "string" },
              "ref": { "type": "string" },
              "sha": { "type": "string" },
              "actor": { "type": "string" },
              "runId": { "type": "string" },
              "runUrl": { "type": "string" }
            },
            "required": ["workflow", "repository"]
          },
          "validations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "passed": { "type": "boolean" },
                "required": { "type": "boolean" },
                "details": { "type": "string" }
              },
              "required": ["name", "passed"]
            }
          },
          "nonce": { "type": "string" },
          "contract_address": { "type": "string" },
          "network": { "type": "string", "enum": ["bscMainnet", "bscTestnet"] },
          "allow_mainnet_writes": { "type": "boolean" },
          "log_sensitive": { "type": "boolean" }
        },
        "required": [
          "commit_id",
          "model_version",
          "context",
          "validations",
          "nonce",
          "contract_address"
        ]
      }
    }
  }
]
