{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawcommit.dev/schemas/ai-decision-verified.claim.schema.json",
  "title": "AI_DECISION_VERIFIED_V1",
  "description": "BAS-compatible claim shape for verified ClawCommit decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clawContract",
    "commitId",
    "commitmentHash",
    "revealTxHash",
    "modelVersion",
    "replayVerified",
    "verifier",
    "verifiedAt",
    "metadataURI"
  ],
  "properties": {
    "clawContract": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "commitId": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "commitmentHash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "revealTxHash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1
    },
    "replayVerified": {
      "type": "boolean"
    },
    "verifier": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "verifiedAt": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "metadataURI": {
      "type": "string"
    }
  }
}
