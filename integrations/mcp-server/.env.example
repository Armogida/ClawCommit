# ClawCommit MCP Server Environment Variables

# Required for commit/reveal operations (transactions that modify blockchain state)
# Export your private key from MetaMask or your wallet
DEPLOYER_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Optional: Custom RPC endpoints (defaults are provided if omitted)
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# Note: The .env file should be placed in this directory or in the project root
# Never commit your actual private key to version control!
