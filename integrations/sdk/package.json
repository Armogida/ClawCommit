{
  "name": "@clawcommit/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for ClawCommit - AI Decision Commit-Reveal Protocol on BNB Chain",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "ts-node test.ts",
    "quickstart": "ts-node quickstart.ts",
    "examples": "ts-node examples.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "bnb-chain",
    "bsc",
    "commit-reveal",
    "ai",
    "blockchain",
    "typescript",
    "sdk",
    "ethers"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.4.0",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
