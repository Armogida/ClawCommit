{
  "name": "clawcommit",
  "version": "1.0.0",
  "description": "Deterministic AI Decision Commit-Reveal Protocol for BNB Chain",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "deploy:local": "hardhat run src/scripts/deploy.js",
    "deploy:testnet": "hardhat run src/scripts/deploy.js --network bscTestnet",
    "deploy:mainnet": "hardhat run src/scripts/deploy.js --network bscMainnet"
  },
  "keywords": ["bnb-chain", "bsc", "commit-reveal", "ai", "deterministic", "smart-contract"],
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "dotenv": "^16.4.0",
    "hardhat": "^2.22.0"
  }
}
