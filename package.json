{
  "name": "clawcommit",
  "version": "1.0.0",
  "description": "Deterministic AI Decision Commit-Reveal Protocol for BNB Chain",
  "scripts": {
    "check:node": "node -e \"const major = Number(process.versions.node.split('.')[0]); if (major !== 20) { console.error('Unsupported Node.js version ' + process.versions.node + '. Use Node 20.x (see .nvmrc).'); process.exit(1); }\"",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.ts",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network bsc",
    "deploy:prove": "hardhat run scripts/deployAndProve.ts --network bscTestnet",
    "commit": "HARDHAT_NETWORK=bscTestnet ts-node scripts/commit.ts",
    "reveal": "HARDHAT_NETWORK=bscTestnet ts-node scripts/reveal.ts",
    "replay": "ts-node scripts/replay.ts",
    "decision:links": "node scripts/integration/post-cycle-links.js",
    "pipeline": "HARDHAT_NETWORK=bscTestnet ts-node backend/aiPipeline.ts",
    "batch:build": "ts-node scripts/batch/build.ts",
    "batch:recompute": "ts-node scripts/batch/recomputeRoot.ts",
    "batch:deploy": "hardhat run scripts/batch/deployBatch.ts --network bscTestnet",
    "batch:commit": "HARDHAT_NETWORK=bscTestnet ts-node scripts/batch/commitBatch.ts",
    "batch:get": "HARDHAT_NETWORK=bscTestnet ts-node scripts/batch/getBatch.ts",
    "batch:proof": "ts-node scripts/batch/generateProof.ts",
    "batch:reveal-leaf": "HARDHAT_NETWORK=bscTestnet ts-node scripts/batch/revealLeaf.ts",
    "batch:reveal-leaves": "HARDHAT_NETWORK=bscTestnet ts-node scripts/batch/revealLeaves.ts",
    "batch:replay": "ts-node scripts/batch/replayBatch.ts",
    "batch:demo:local": "bash scripts/batch/demoLocal.sh",
    "mcp:setup": "bash integrations/mcp-server/setup-local.sh",
    "mcp:setup:interactive": "bash integrations/mcp-server/setup-local.sh --configure-env",
    "mcp:env": "bash integrations/mcp-server/configure-env.sh",
    "mcp:start": "bash integrations/mcp-server/run-mcp.sh",
    "mcp:test": "npm --prefix integrations/mcp-server test",
    "openclaw:attest": "node integrations/openclaw/openclaw.js",
    "openclaw:convert": "node integrations/openclaw/convert-to-clawcommit.js"
  },
  "keywords": ["bnb-chain", "bsc", "commit-reveal", "ai", "deterministic", "smart-contract"],
  "license": "MIT",
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.0",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.0",
    "ts-node": "^10.9.0",
    "typechain": "^8.3.0",
    "typescript": "^5.4.0"
  }
}
